// Marketing AI Assistant — Prisma Schema
// PostgreSQL 16

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Enums
// =============================================================================

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

enum OrgPlan {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  active
  trialing
  past_due
  canceled
  incomplete
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ProjectType {
  WEBSITE
  MOBILE_APP
  SAAS
  ECOMMERCE
  BLOG
  OTHER
}

enum SocialPlatform {
  TWITTER
  LINKEDIN
  FACEBOOK
  INSTAGRAM
  GOOGLE
  TELEGRAM
}

enum CampaignType {
  EMAIL
  SOCIAL
  BLOG
  MULTI_CHANNEL
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
}

enum ContentType {
  SOCIAL_POST
  BLOG_ARTICLE
  EMAIL
  NEWSLETTER
  AD_COPY
  LANDING_PAGE
  SEO_ARTICLE
  REFERRAL_COPY
  IN_APP_MESSAGE
}

enum ContentStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
  REJECTED
}

enum EmailProvider {
  SMTP
  RESEND
}

enum EmailAccountStatus {
  ACTIVE
  INACTIVE
  ERROR
}

enum EmailSubscriberStatus {
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
}

enum ChecklistType {
  LAUNCH
  WEEKLY
  CAMPAIGN_PREP
  SEO
  SOCIAL_MEDIA
  EMAIL_CAMPAIGN
  COMPETITIVE_ANALYSIS
  CUSTOM
  PRODUCT_HUNT_LAUNCH
}

enum ChecklistItemPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DocumentType {
  MARKETING_PLAN
  REPORT
  COMPETITIVE_ANALYSIS
  BRAND_GUIDELINES
  CONTENT_CALENDAR
  PROPOSAL
  PRESENTATION
  PRODUCT_HUNT_BRIEF
}

enum AgentType {
  STRATEGY
  CONTENT
  SEO
  SOCIAL_MEDIA
  EMAIL
  ANALYTICS
  CHECKLIST
  DOCUMENT
  SUPERVISOR
}

enum AgentRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum AnalyticsEventType {
  PAGE_VIEW
  EMAIL_OPEN
  EMAIL_CLICK
  SOCIAL_ENGAGEMENT
  CONVERSION
  SIGNUP
  TRIAL_START
  ACTIVATION
  UPGRADE
  CHURN
  FUNNEL_STEP
}


enum ABTestStatus {
  DRAFT
  RUNNING
  PAUSED
  COMPLETED
}

enum ABTestType {
  EMAIL_SUBJECT
  CONTENT_VARIANT
  LANDING_PAGE
}

enum EmailSequenceTrigger {
  SIGNUP
  MANUAL
  EVENT
  DATE
}

enum EmailSequenceStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  PAUSED
  UNSUBSCRIBED
}

enum KeywordIntent {
  INFORMATIONAL
  NAVIGATIONAL
  COMMERCIAL
  TRANSACTIONAL
}

enum SocialAccountStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  ERROR
}

enum PublicationStatus {
  PENDING
  PUBLISHED
  FAILED
}

// =============================================================================
// Users & Auth
// =============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String?
  avatarUrl     String?
  emailVerified Boolean   @default(false)
  googleId      String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships       OrganizationMember[]
  contentVersions   ContentVersion[]
  completedItems    ChecklistItem[]      @relation("CompletedBy")
  createdDocuments  Document[]
  chatSessions      ChatSession[]

  @@index([email])
  @@map("users")
}

// =============================================================================
// Organizations & SaaS
// =============================================================================

model Organization {
  id                   String    @id @default(cuid())
  name                 String
  slug                 String    @unique
  plan                 OrgPlan   @default(FREE)
  logoUrl              String?
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  trialEndsAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  members        OrganizationMember[]
  projects       Project[]
  subscription   Subscription?
  emailAccounts  EmailAccount[]
  emailTemplates EmailTemplate[]
  socialAccounts SocialAccount[]
  webhooks       Webhook[]

  @@index([slug])
  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           UserRole     @default(MEMBER)
  invitedAt      DateTime?
  joinedAt       DateTime?
  requestedAt    DateTime?
  createdAt      DateTime     @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("organization_members")
}

model Subscription {
  id                   String             @id @default(cuid())
  organizationId       String             @unique
  plan                 OrgPlan
  status               SubscriptionStatus @default(trialing)
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAt             DateTime?
  canceledAt           DateTime?
  stripeSubscriptionId String?            @unique
  stripeCustomerId     String?
  stripeData           Json?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// =============================================================================
// Projects
// =============================================================================

model Project {
  id             String        @id @default(cuid())
  organizationId String
  trackingId     String?       @unique @default(cuid())
  name           String
  projectType    ProjectType @default(WEBSITE)
  description    String?
  websiteUrl     String?
  logoUrl        String?
  targetAudience String?
  brandVoice     Json?
  industry       String?
  goals          Json?
  socialLinks    Json?
  status         ProjectStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apiKeys         ProjectApiKey[]
  campaigns       Campaign[]
  content         Content[]
  emailLists      EmailList[]
  checklists      Checklist[]
  documents       Document[]
  agentRuns       AgentRun[]
  agentSchedules  AgentSchedule[]
  analyticsEvents AnalyticsEvent[]
  dailyMetrics    DailyMetrics[]
  socialAccounts  ProjectSocialAccount[]
  keywords        Keyword[]
  abTests         ABTest[]
  emailSequences  EmailSequence[]
  chatSessions    ChatSession[]
  competitors     Competitor[]
  funnelSteps     FunnelStep[]
  trackedUsers    TrackedUser[]

  @@index([organizationId])
  @@map("projects")
}

model ProjectApiKey {
  id               String         @id @default(cuid())
  projectId        String
  platform         SocialPlatform
  encryptedKey     String
  scopes           String[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, platform])
  @@map("project_api_keys")
}

// =============================================================================
// Campaigns & Content
// =============================================================================

model Campaign {
  id        String         @id @default(cuid())
  projectId String
  name      String
  type      CampaignType
  status    CampaignStatus @default(DRAFT)
  startDate DateTime?
  endDate   DateTime?
  budget    Float?
  goals     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  content        Content[]
  emailCampaigns EmailCampaign[]
  analyticsEvents AnalyticsEvent[]

  @@index([projectId])
  @@map("campaigns")
}

model Content {
  id              String         @id @default(cuid())
  campaignId      String?
  projectId       String
  sourceContentId String?
  type            ContentType
  title           String
  body            String         @db.Text
  mediaUrls       String[]
  platform        SocialPlatform?
  status          ContentStatus  @default(DRAFT)
  scheduledAt     DateTime?
  publishedAt     DateTime?
  aiGenerated     Boolean        @default(false)
  seoMetadata     Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  project        Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  campaign       Campaign?            @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  sourceContent  Content?             @relation("ContentRepurpose", fields: [sourceContentId], references: [id], onDelete: SetNull)
  repurposed     Content[]            @relation("ContentRepurpose")
  versions       ContentVersion[]
  publications   ContentPublication[]
  abTestVariants ABTestVariant[]

  @@index([projectId])
  @@index([campaignId])
  @@map("content")
}

model ContentVersion {
  id        String   @id @default(cuid())
  contentId String
  version   Int
  body      String   @db.Text
  editedBy  String
  createdAt DateTime @default(now())

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  editor  User    @relation(fields: [editedBy], references: [id])

  @@unique([contentId, version])
  @@map("content_versions")
}

// =============================================================================
// Email Marketing
// =============================================================================

model EmailAccount {
  id                   String             @id @default(cuid())
  organizationId       String
  email                String
  displayName          String?
  smtpHost             String?
  smtpPort             Int?
  imapHost             String?
  imapPort             Int?
  encryptedCredentials String?
  status               EmailAccountStatus @default(ACTIVE)
  provider             EmailProvider      @default(SMTP)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  emailCampaigns EmailCampaign[]

  @@index([organizationId])
  @@map("email_accounts")
}

model EmailList {
  id              String   @id @default(cuid())
  projectId       String
  name            String
  description     String?
  subscriberCount Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subscribers     EmailSubscriber[]
  emailCampaigns  EmailCampaign[]

  @@index([projectId])
  @@map("email_lists")
}

model EmailSubscriber {
  id              String                @id @default(cuid())
  listId          String
  email           String
  name            String?
  status          EmailSubscriberStatus @default(ACTIVE)
  metadata        Json?
  subscribedAt    DateTime              @default(now())
  unsubscribedAt  DateTime?
  unsubscribeToken String              @unique @default(cuid())

  list EmailList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, email])
  @@index([email])
  @@map("email_subscribers")
}

model EmailTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  html           String   @db.Text
  mjml           String?  @db.Text
  category       String
  thumbnail      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  emailCampaigns EmailCampaign[]

  @@index([organizationId])
  @@map("email_templates")
}

model EmailCampaign {
  id             String    @id @default(cuid())
  campaignId     String
  emailAccountId String
  listId         String
  subject        String
  previewText    String?
  templateId     String?
  html           String    @db.Text
  status         String    @default("draft")
  sentAt         DateTime?
  stats          Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  emailAccount EmailAccount @relation(fields: [emailAccountId], references: [id])
  list         EmailList    @relation(fields: [listId], references: [id])
  template     EmailTemplate? @relation(fields: [templateId], references: [id])

  @@index([campaignId])
  @@map("email_campaigns")
}

// =============================================================================
// Checklists & Tasks
// =============================================================================

model Checklist {
  id          String        @id @default(cuid())
  projectId   String
  name        String
  type        ChecklistType
  description String?
  isTemplate  Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items   ChecklistItem[]

  @@index([projectId])
  @@map("checklists")
}

model ChecklistItem {
  id          String                @id @default(cuid())
  checklistId String
  title       String
  description String?
  isCompleted Boolean               @default(false)
  completedAt DateTime?
  completedBy String?
  order       Int
  dueDate     DateTime?
  priority    ChecklistItemPriority @default(MEDIUM)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  completedByUser User? @relation("CompletedBy", fields: [completedBy], references: [id])
  chatMessages Json? // Array of { role: 'user' | 'assistant', content: string }

  @@index([checklistId])
  @@map("checklist_items")
}

// =============================================================================
// Documents
// =============================================================================

model Document {
  id            String       @id @default(cuid())
  projectId     String
  type          DocumentType
  title         String
  content       Json?
  contentMd     String?      @db.Text
  fileUrl       String?
  generatedByAi Boolean      @default(false)
  version       Int          @default(1)
  createdBy     String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator User    @relation(fields: [createdBy], references: [id])

  @@index([projectId])
  @@map("documents")
}

// =============================================================================
// AI Agent
// =============================================================================

model AgentRun {
  id             String         @id @default(cuid())
  projectId      String
  agentType      AgentType
  status         AgentRunStatus @default(PENDING)
  input          Json
  output         Json?
  tokensUsed     Int?
  cost           Float?
  duration       Int?
  error          String?
  langsmithRunId   String?
  langsmithTraceUrl String?
  createdAt        DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@map("agent_runs")
}

model AgentSchedule {
  id             String    @id @default(cuid())
  projectId      String
  agentType      AgentType
  cronExpression String
  isActive       Boolean   @default(true)
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  config         Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, agentType])
  @@map("agent_schedules")
}

// =============================================================================
// Analytics
// =============================================================================

model AnalyticsEvent {
  id         String             @id @default(cuid())
  projectId  String
  campaignId String?
  type       AnalyticsEventType
  metadata   Json               @default("{}")
  timestamp  DateTime           @default(now())

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([timestamp])
  @@index([projectId, type, timestamp])
  @@map("analytics_events")
}

model DailyMetrics {
  id        String   @id @default(cuid())
  projectId String
  date      DateTime @db.Date
  metrics   Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, date])
  @@index([projectId, date])
  @@map("daily_metrics")
}

// =============================================================================
// Social Publishing
// =============================================================================

model SocialAccount {
  id              String              @id @default(cuid())
  organizationId  String
  platform        SocialPlatform
  accountName     String
  accountId       String
  profileImageUrl String?
  encryptedTokens String
  status          SocialAccountStatus @default(ACTIVE)
  scopes          String[]
  expiresAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  publications ContentPublication[]
  projects     ProjectSocialAccount[]

  @@unique([organizationId, platform, accountId])
  @@index([organizationId])
  @@map("social_accounts")
}

model ProjectSocialAccount {
  projectId       String
  socialAccountId String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@id([projectId, socialAccountId])
  @@map("project_social_accounts")
}

model ContentPublication {
  id              String            @id @default(cuid())
  contentId       String
  socialAccountId String
  platform        SocialPlatform
  platformPostId  String?
  platformPostUrl String?
  status          PublicationStatus @default(PENDING)
  publishedAt     DateTime?
  error           String?
  createdAt       DateTime          @default(now())

  content       Content       @relation(fields: [contentId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@index([socialAccountId])
  @@map("content_publications")
}

// =============================================================================
// SEO & Keywords
// =============================================================================

model Keyword {
  id           String       @id @default(cuid())
  projectId    String
  keyword      String
  searchVolume Int?
  difficulty   Int?
  currentRank  Int?
  targetRank   Int?
  intent       KeywordIntent @default(INFORMATIONAL)
  url          String?
  isTracking   Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rankHistory  KeywordRankHistory[]

  @@unique([projectId, keyword])
  @@index([projectId])
  @@map("keywords")
}

model KeywordRankHistory {
  id        String   @id @default(cuid())
  keywordId String
  date      DateTime @db.Date
  rank      Int?
  url       String?
  createdAt DateTime @default(now())

  keyword Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@unique([keywordId, date])
  @@index([keywordId, date])
  @@map("keyword_rank_history")
}

// =============================================================================
// A/B Testing
// =============================================================================

model ABTest {
  id              String       @id @default(cuid())
  projectId       String
  name            String
  type            ABTestType
  status          ABTestStatus @default(DRAFT)
  startDate       DateTime?
  endDate         DateTime?
  winnerVariantId String?
  config          Json         @default("{}")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  project  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  variants ABTestVariant[]

  @@index([projectId])
  @@map("ab_tests")
}

model ABTestVariant {
  id           String  @id @default(cuid())
  testId       String
  name         String
  contentId    String?
  config       Json    @default("{}")
  impressions  Int     @default(0)
  conversions  Int     @default(0)
  clicks       Int     @default(0)
  isControl    Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  test    ABTest   @relation(fields: [testId], references: [id], onDelete: Cascade)
  content Content? @relation(fields: [contentId], references: [id], onDelete: SetNull)

  @@index([testId])
  @@map("ab_test_variants")
}

// =============================================================================
// Email Sequences (Drip Campaigns)
// =============================================================================

model EmailSequence {
  id          String                @id @default(cuid())
  projectId   String
  name        String
  description String?
  triggerType EmailSequenceTrigger  @default(MANUAL)
  triggerConfig Json               @default("{}")
  status      EmailSequenceStatus   @default(DRAFT)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  project     Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  steps       EmailSequenceStep[]
  enrollments EmailSequenceEnrollment[]

  @@index([projectId])
  @@map("email_sequences")
}

model EmailSequenceStep {
  id         String  @id @default(cuid())
  sequenceId String
  order      Int
  delayDays  Int     @default(0)
  delayHours Int     @default(0)
  subject    String
  previewText String?
  html       String  @db.Text
  templateId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sequence EmailSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, order])
  @@index([sequenceId])
  @@map("email_sequence_steps")
}

model EmailSequenceEnrollment {
  id               String           @id @default(cuid())
  sequenceId       String
  subscriberId     String
  currentStepIndex Int              @default(0)
  status           EnrollmentStatus @default(ACTIVE)
  enrolledAt       DateTime         @default(now())
  nextSendAt       DateTime?
  completedAt      DateTime?
  updatedAt        DateTime         @updatedAt

  sequence EmailSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, subscriberId])
  @@index([status, nextSendAt])
  @@map("email_sequence_enrollments")
}

// =============================================================================
// Chat History
// =============================================================================

model ChatSession {
  id        String   @id @default(cuid())
  projectId String?
  userId    String
  title     String   @default("New Chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId])
  @@index([projectId])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  content   String   @db.Text
  tokensUsed Int?
  cost      Float?
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("chat_messages")
}

// =============================================================================
// Competitor Monitoring
// =============================================================================

model Competitor {
  id           String   @id @default(cuid())
  projectId    String
  name         String
  websiteUrl   String
  description  String?
  lastCheckedAt DateTime?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project   Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  snapshots CompetitorSnapshot[]

  @@unique([projectId, websiteUrl])
  @@index([projectId])
  @@map("competitors")
}

model CompetitorSnapshot {
  id           String   @id @default(cuid())
  competitorId String
  date         DateTime @db.Date
  data         Json     @default("{}")
  changes      Json?
  createdAt    DateTime @default(now())

  competitor Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@unique([competitorId, date])
  @@index([competitorId, date])
  @@map("competitor_snapshots")
}

// =============================================================================
// Conversion Funnels
// =============================================================================

model FunnelStep {
  id          String @id @default(cuid())
  projectId   String
  name        String
  eventType   String
  order       Int
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, order])
  @@index([projectId])
  @@map("funnel_steps")
}

// =============================================================================
// Tracked Users (for analytics identity)
// =============================================================================

model TrackedUser {
  id             String   @id @default(cuid())
  projectId      String
  externalUserId String?
  email          String?
  traits         Json     @default("{}")
  firstSeen      DateTime @default(now())
  lastSeen       DateTime @default(now())
  sessionCount   Int      @default(1)
  totalPageViews Int      @default(0)
  firstUtm       Json?
  lastUtm        Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, externalUserId])
  @@index([projectId])
  @@index([email])
  @@map("tracked_users")
}

// =============================================================================
// Webhooks
// =============================================================================

model Webhook {
  id             String   @id @default(cuid())
  organizationId String
  url            String
  events         String[]
  secret         String
  isActive       Boolean  @default(true)
  lastTriggeredAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("webhooks")
}
